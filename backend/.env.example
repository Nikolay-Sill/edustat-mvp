# Скопируйте в backend/.env и при необходимости поменяйте значения.
# Значения ниже совпадают с docker-compose.yml (только для локальной разработки).
EDUSTAT_DATABASE_URL=postgresql+psycopg://edustat:edustat@localhost:55432/edustat
# База для автотестов: пересоздаётся при каждом запуске pytest
EDUSTAT_TEST_DATABASE_URL=postgresql+psycopg://edustat:edustat@localhost:55432/edustat_test
EDUSTAT_LOG_LEVEL=INFO
